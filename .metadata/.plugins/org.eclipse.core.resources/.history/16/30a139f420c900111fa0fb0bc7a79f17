<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<%! String[] names = {"김철수", "이영희", "박민수","최지우","정다은"};
		int[] scores ={92,78,55,85,67};
				
		getGrade(int score){
			for(int i=0; i<scores.length; i++){
				if(scores[i]>=90){
					grades[i] = 'A';			
				}else if(scores[i]>=80){
					grades[i] ='B';
				}else if(scores[i]>=70){
					grades[i] ='C';
				}else if(scores[i]>=60){
					grades[i] ='D';
				}else {
					grades[i] = 'F';
				}
			}
			return grades[i];
		}
	%>
	<h1>성적표</h1>
	<table>
		<tr>
			<th>번호</th><th>이름</th><th>점수</th><th>등급</th><th>그래프</th>
		</tr>
		<% for(int i=0; i<scores.length; i++){	%>
		<tr>	
			<td><%=i+1 %></td>
			<td><%=names[i] %></td>
			<td><%=scores[i] %></td>
			<td><%=getGreade(scores[i])%></td>
			<td><div style="width: <%=scores[i]*3 %>px;"></div></td>
		</tr>			
		<% }; %>
	</table>
	
	</body>
</html>