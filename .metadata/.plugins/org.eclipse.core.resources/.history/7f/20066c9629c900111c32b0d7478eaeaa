<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>

	<table>
		<tr>
			<th>숫자</th><th>제곱</th><th>구분</th>
		</tr>
		<% 
			for(int i=1; i<=20; i++){	%>
			<tr style="background-color:<%= (i%2==0) ? "#e6f2ff":"#ffffff" %>">
				<td><%= i %></td>
				<td><%= i*i %></td>
				<td><%= i %></td>
			</tr>	
		<%	}	%>
		</table>
		
		
		
	
	
	
	
	</table>

</body>
</html>