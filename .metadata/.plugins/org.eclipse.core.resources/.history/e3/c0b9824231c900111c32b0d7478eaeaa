<body>

	<h2>번호판</h2>
	<br/>
	<%! int count = 1; 
		int[] winNums = {3,12,19,27,33,41};
		public boolean isWinning(int num){
			for(int i=0;i<winNums.length; i++){
				if(winNums[i] == num){
					return true;
				}else{		
					return false;
				}
			}
		};
	%>
	<table border="1">
		<% for(int i=1; i<=5; i++){	%>
		<tr>
			<%	for(int j=1; j<=9; j++){	%>
			<td><%=count %></td>
			<% count++;
			}; %>
		</tr>	
		<%}; %>
	</table>

</body>
