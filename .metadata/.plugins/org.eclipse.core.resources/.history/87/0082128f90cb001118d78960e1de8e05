<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>회원가입 처리</title>
</head>
<body>
	<%
		/* 스크립트릿은 자바코드만 가능 */
		request.setCharacterEncoding("utf-8");
	
		//RequestJoin.jsp의 입력된 정보를 Request 객체를 통해 
		//정보를 꺼내오세요
		
		
		
		String id = request.getParameter("id");
		String pass= request.getParameter("pass");
		String passchk = request.getParameter("passchk");	//비밀번호 확인용
		String email = request.getParameter("email");
		String tel = request.getParameter("tel");
		/* 체크박스는 동시에 여러 개를 선택해야 하므로 배열에 담는다.  */
		String[] hobby = request.getParameterValues("hobby");
		String job = request.getParameter("job");
		String age = request.getParameter("age");
		String info = request.getParameter("info");
		
		/* 비밀번호와 비밀번호 체크가 같아야 회원가입 성공 */
		if(!pass.equals(passchk)){
			/* "비밀번호가 틀립니다. 메시지 창 띄우기"  */
	%>
	<script type="text/javascript">
			alert("비밀번호가 틀립니다.");
	</script>			
	<%			
		}
	%>
	
	<table border="1">
		<tr>
			<td>id</td>
			<td><%= id %></td>
		</tr>
		<tr>
			<td>pass</td>
			<td><%= pass %></td>
		</tr>
		<tr>
			<td>passchk</td>
			<td><%= passchk %></td>
		</tr>
		<tr>
			<td>tel</td>
			<td><%= tel %></td>
		</tr>
		<tr>
			<td>email</td>
			<td><%= email %></td>
		</tr>
		<tr>
			<td>hobby</td>
			<td><% for(int i=0; i<hobby.length; i++){ %>
					<%= hobby[i] %>
				<% } %>
			</td>
			
		</tr>
		<tr>
			<td>job</td>
			<td><%= job %></td>
		</tr>
		<tr>
			<td>age</td>
			<td><%= age %></td>
		</tr>
		<tr>
			<td>info</td>
			<td><%= info %></td>
		</tr>
		
	
	
	</table>
	
	
	
</body>
</html>