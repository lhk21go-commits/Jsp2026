<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>

	<h2>번호판</h2>
	<br/>
	<%! int count = 1; %>
	<table border="1">
		<% for(int i=1; i<=5; i++){	%>
		<tr>
			<%	for(int j=1; j<=9; j++){	%>
			<td><%=count %></td>
			<% count++;
			}; %>
		</tr>	
		<%}; %>
	</table>

</body>
</html>